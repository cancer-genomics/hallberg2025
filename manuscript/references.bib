 author = {Pidsley, Ruth and Zotenko, Elena and Peters, Timothy J. and Lawrence, Mitchell G. and Risbridger, Gail P. and Molloy, Peter and Van Djik, Susan and Muhlhausler, Beverly and Stirzaker, Clare and Clark, Susan J.},
