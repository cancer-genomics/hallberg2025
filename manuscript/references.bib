@article{zeng2018,
  title = {Targeting {MYC} Dependency in Ovarian Cancer through Inhibition of {CDK7} and {CDK12}/13},
  author = {Zeng, Mei and Kwiatkowski, Nicholas P. and Zhang, Tinghu and Nabet, Behnam and Xu, Mousheng and Liang, Yanke and Quan, Chunshan and Wang, Jinhua and Hao, Mingfeng and Palakurthi, Sangeetha and Zhou, Shan and Zeng, Qing and Kirschmeier, Paul T. and Meghani, Khyati and Leggett, Alan L. and Qi, Jun and Shapiro, Geoffrey I. and Liu, Joyce F. and Matulonis, Ursula A. and Lin, Charles Y. and Konstantinopoulos, Panagiotis A. and Gray, Nathanael S.},
  year = {2018},
  month = nov,
  journal = {Elife},
